# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Source/docs stay LF even on Windows.
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.csv   text eol=lf

# Binary artifacts are never normalized.
*.png   binary
*.jpg   binary
*.parquet binary
